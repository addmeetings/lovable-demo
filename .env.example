# Port Minecraft Education connects to with: /connect localhost:3000
MC_WS_PORT=3000
# Port the HTTP API (used by the `mc` CLI) listens on
API_PORT=3001
# Interface to bind. 127.0.0.1 keeps everything on your Mac.
# Use 0.0.0.0 only if Minecraft runs on another machine on your LAN.
HOST=127.0.0.1
# Optional shared secret. If set, the CLI must send the same value (MC_API_TOKEN).
API_TOKEN=
